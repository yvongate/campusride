// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

// Get a free hosted Postgres database in seconds: `npx create-db`

generator client {
  provider     = "prisma-client"
  output       = "../generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

model Utilisateur {
  id                    String                  @id @default(cuid())
  nom                   String?
  prenom                String?
  telephone             String?                 @unique
  email                 String?                 @unique
  passwordHash          String?
  role                  String                  @default("etudiant")
  // "note" est la valeur publique (affichee partout), toujours derivee de
  // noteBrute - penaliteCumulee (voir back/src/common/utils/note.ts) -- ne
  // jamais l'ecrire directement ailleurs que via computeNote, sinon on
  // reproduit le bug ou une notation effacait les penalites (et vice versa).
  note                  Float?
  noteBrute             Float?
  nombreNotations       Int                     @default(0)
  penaliteCumulee       Float                   @default(0)
  actif                 Boolean                 @default(true)
  // Compteur a vie des annulations tardives (< 2h avant le depart) en tant
  // que passager -- 1re annulation tardive tolerée, la 2e (et suivantes)
  // declenche suspenduJusqua (voir TrajetsService.annulerReservation).
  annulationsTardives   Int                     @default(0)
  // Bannissement temporaire reel (pas juste une baisse de note) : tant que
  // cette date est dans le futur, JwtStrategy et AuthService.verifyOtp
  // refusent l'acces. Remis a null par un admin via reactiverCompte (voir
  // UsersService) en cas de recours.
  suspenduJusqua        DateTime?
  createdAt             DateTime                @default(now())
  // Universite de l'etudiant, renseignee une fois (premiere connexion ou
  // "Mes informations"), reutilisee comme destination par defaut sur
  // l'Accueil et CreerDemande -- optionnel et modifiable a tout moment,
  // jamais un blocage a l'entree dans l'app (meme principe que "nom").
  universiteId          String?
  universite            Universite?             @relation(fields: [universiteId], references: [id])
  documentsConducteur   DocumentsConducteur[]
  trajets               Trajet[]
  reservations          Reservation[]
  demandes              Demande[]
  participations        Participation[]
  messages              Message[]
  notationsDonnees      Notation[]              @relation("NotationsDonnees")
  notationsRecues       Notation[]              @relation("NotationsRecues")
  signalementsEmis      Signalement[]           @relation("SignalementsEmis")
  signalementsRecus     Signalement[]           @relation("SignalementsRecus")
  appareilsPush         AppareilPush[]
  messagesSupport       MessageSupport[]
}

// Canal de contact utilisateur -> administration. Volontairement en base
// plutot qu'un simple lien mailto : c'est le seul recours d'un compte
// suspendu automatiquement (voir §8.2), il doit donc rester accessible
// depuis l'app et laisser une trace consultable dans le back-office.
model MessageSupport {
  id          String      @id @default(cuid())
  userId      String
  utilisateur Utilisateur @relation(fields: [userId], references: [id])
  contenu     String
  statut      String      @default("ouvert")
  // Reponse de l'administration, visible par l'utilisateur dans l'app.
  reponse     String?
  createdAt   DateTime    @default(now())
  repondueLe  DateTime?

  @@index([statut, createdAt])
}

// Un utilisateur peut etre connecte sur plusieurs appareils, et un meme
// appareil peut changer de token (reinstallation, mise a jour). D'ou une
// table dediee plutot qu'un champ sur Utilisateur : elle permet aussi de
// supprimer le token A LA DECONNEXION -- sans ca, la personne suivante a
// utiliser le telephone recevrait les notifications du compte precedent.
model AppareilPush {
  id           String      @id @default(cuid())
  userId       String
  utilisateur  Utilisateur @relation(fields: [userId], references: [id])
  // Token Expo ("ExponentPushToken[...]"). Unique : un meme appareil ne doit
  // exister qu'une fois, et s'il change de compte il bascule simplement de
  // userId (voir NotificationsService.enregistrerAppareil).
  token        String      @unique
  plateforme   String
  createdAt    DateTime    @default(now())
  dernierUsage DateTime    @updatedAt
}

model DocumentsConducteur {
  id                String      @id @default(cuid())
  userId            String
  utilisateur       Utilisateur @relation(fields: [userId], references: [id])
  selfie            String
  photoPermis       String
  matriculeVehicule String
  photoVehicule     String?
  motBienvenue      String?
  statut            String      @default("en attente")
  createdAt         DateTime    @default(now())
}

model Universite {
  id        String   @id @default(cuid())
  nom       String
  commune   String
  latitude  Float
  longitude Float
  createdAt DateTime @default(now())
  trajets   Trajet[]
  demandes  Demande[]
  etudiants Utilisateur[]
}

model Commune {
  id        String     @id @default(cuid())
  nom       String
  ville     String
  createdAt DateTime   @default(now())
  quartiers Quartier[]
  demandes  Demande[]
}

model Quartier {
  id            String         @id @default(cuid())
  nom           String
  communeId     String
  commune       Commune        @relation(fields: [communeId], references: [id])
  createdAt     DateTime       @default(now())
  pointsInteret PointInteret[]
  demandes      Demande[]
}

model PointInteret {
  id         String   @id @default(cuid())
  nom        String
  type       String
  quartierId String
  quartier   Quartier @relation(fields: [quartierId], references: [id])
  latitude   Float
  longitude  Float
  createdAt  DateTime @default(now())
  trajets    Trajet[]
  demandes   Demande[]
}

model Trajet {
  id           String       @id @default(cuid())
  conducteurId String
  conducteur   Utilisateur  @relation(fields: [conducteurId], references: [id])
  universiteId String
  universite   Universite   @relation(fields: [universiteId], references: [id])
  pointDeRdvId String
  pointDeRdv   PointInteret @relation(fields: [pointDeRdvId], references: [id])
  heure        DateTime
  places       Int
  // Montant fixe du a par CHAQUE passager (remplace l'ancien "prixTotal" qui
  // etait divise dynamiquement entre les reservants) -- le prix annonce ne
  // bouge donc plus jamais, ni quand un passager rejoint, ni quand il annule.
  // Meme semantique que Demande.cotisation, voir cahier des charges §6.
  cotisation   Float
  mode         String       @default("B")
  statut       String       @default("ouvert")
  rappel2hEnvoye Boolean    @default(false)
  rappel1hEnvoye Boolean    @default(false)
  createdAt    DateTime     @default(now())
  reservations Reservation[]
  messages     Message[]
  notations    Notation[]
  signalements Signalement[]
  demande      Demande?
}

model Reservation {
  id              String      @id @default(cuid())
  trajetId        String
  trajet          Trajet      @relation(fields: [trajetId], references: [id])
  passagerId      String
  passager        Utilisateur @relation(fields: [passagerId], references: [id])
  prixParPersonne Float
  statut          String      @default("confirmee")
  createdAt       DateTime    @default(now())
}

model Demande {
  id                String          @id @default(cuid())
  createurId        String
  createur          Utilisateur     @relation(fields: [createurId], references: [id])
  universiteId      String
  universite        Universite      @relation(fields: [universiteId], references: [id])
  communeId         String
  commune           Commune         @relation(fields: [communeId], references: [id])
  quartierId        String?
  quartier          Quartier?       @relation(fields: [quartierId], references: [id])
  poiId             String?
  poi               PointInteret?   @relation(fields: [poiId], references: [id])
  heure             DateTime
  placesRecherchees Int
  cotisation        Float
  statut            String          @default("ouverte")
  createdAt         DateTime        @default(now())
  participations    Participation[]
  // Renseigne uniquement quand accepterDemande cree le Trajet correspondant
  // (statut "acceptee") -- necessaire pour que l'ecran "Point de
  // regroupement" cote front_mobile puisse retrouver le conducteur qui a
  // accepte, aucune autre relation ne permet de relier Demande -> Trajet.
  trajetId          String?         @unique
  trajet            Trajet?         @relation(fields: [trajetId], references: [id])
}

model Participation {
  id          String      @id @default(cuid())
  demandeId   String
  demande     Demande     @relation(fields: [demandeId], references: [id])
  userId      String
  utilisateur Utilisateur @relation(fields: [userId], references: [id])
  positionLat Float
  positionLng Float
  statut      String      @default("confirmee")
  createdAt   DateTime    @default(now())
}

model Message {
  id           String      @id @default(cuid())
  trajetId     String
  trajet       Trajet      @relation(fields: [trajetId], references: [id])
  expediteurId String
  expediteur   Utilisateur @relation(fields: [expediteurId], references: [id])
  contenu      String
  createdAt    DateTime    @default(now())
}

model Notation {
  id             String      @id @default(cuid())
  trajetId       String
  trajet         Trajet      @relation(fields: [trajetId], references: [id])
  noteurId       String
  noteur         Utilisateur @relation("NotationsDonnees", fields: [noteurId], references: [id])
  destinataireId String
  destinataire   Utilisateur @relation("NotationsRecues", fields: [destinataireId], references: [id])
  etoiles        Int
  commentaire    String?
  createdAt      DateTime    @default(now())

  @@unique([trajetId, noteurId, destinataireId])
}

model Signalement {
  id           String      @id @default(cuid())
  trajetId     String
  trajet       Trajet      @relation(fields: [trajetId], references: [id])
  type         String
  signaleParId String
  signalePar   Utilisateur @relation("SignalementsEmis", fields: [signaleParId], references: [id])
  concerneId   String
  concerne     Utilisateur @relation("SignalementsRecus", fields: [concerneId], references: [id])
  statut       String      @default("ouvert")
  createdAt    DateTime    @default(now())
}
